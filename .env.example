# Copie este arquivo para ".env" e cole sua chave (https://platform.openai.com/api-keys).
# O .env está no .gitignore e nunca vai para o repositório.
OPENAI_API_KEY=

# Opcional: troque o modelo de imagem padrão.
# OPENAI_IMAGE_MODEL=gpt-image-2

# Sprite Fusion (https://www.spritefusion.com/account/api-keys) - gerador de sprites em pixel art
SPRITE_FUSION_API_KEY=
